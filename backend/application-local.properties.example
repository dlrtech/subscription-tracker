# Copy to application-local.properties (in the backend folder, next to pom.xml) for local development.
# That file is git-ignored; never commit real passwords or secrets.
spring.datasource.url=jdbc:postgresql://localhost:5432/subscription_tracker
spring.datasource.username=postgres
spring.datasource.password=change-me
app.jwt.secret=replace-with-a-random-string-of-at-least-32-characters

# Plain http on localhost: the refresh cookie cannot be Secure here.
app.auth.cookie-secure=false
app.auth.cookie-same-site=Lax
# Interactive API docs at http://localhost:8080/swagger-ui.html (keep them off in production).
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true

# Without SMTP settings the e-mails (verification, password reset) are printed to the console.
# spring.mail.host=smtp.example.com
# spring.mail.username=...
# spring.mail.password=...
