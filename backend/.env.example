# Copy to .env and fill in. .env is git-ignored.
DB_USERNAME=postgres
DB_PASSWORD=change-me
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_CURRENCY=TRY

# URL of the deployed frontend (used in the links inside e-mails)
FRONTEND_URL=http://localhost:5173
# Refresh-token cookie. Local http: false/Lax. Production over https with a frontend on another site: true/None.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# SMTP for verification, password-reset and reminder e-mails. Leave the host empty to only log them.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=subtracker <no-reply@example.com>
